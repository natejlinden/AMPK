      </MiriamAnnotation>
      <Expression>
        Vmaxoxphos_Oxidative_Phosphorylation*((ADP_m)/KADP_Oxidative_Phosphorylation)^nH_Oxidative_Phosphorylation/(1+((ADP_m)/KADP_Oxidative_Phosphorylation)^nH_Oxidative_Phosphorylation)
      </Expression>
      <ListOfParameterDescriptions>
        <ParameterDescription key="FunctionParameter_264" name="ADP_m" order="0" role="substrate"/>

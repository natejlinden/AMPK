        <ParameterDescription key="FunctionParameter_262" name="Vmaxoxphos_Oxidative_Phosphorylation" order="2" role="constant"/>
        <ParameterDescription key="FunctionParameter_261" name="nH_Oxidative_Phosphorylation" order="3" role="constant"/>
      </ListOfParameterDescriptions>
    </Function>
